{
  "name": "denon-remote",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A nicer local web remote for the Denon AVR-X1700H",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.ts & vite; wait",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "node --test server/*.test.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "vite": "^8.3.6"
  }
}

# Receiver IP (give it a DHCP reservation in your router so it never changes)
AVR_HOST=192.168.1.50
# Port this app listens on
PORT=8787
# Set to "off" to never use telnet (HTTP polling only) if another app needs the telnet slot
AVR_TELNET=on
# Where settings and setup backups are stored
# DATA_DIR=./data

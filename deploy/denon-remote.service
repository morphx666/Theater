# systemd unit for running Theater on a Raspberry Pi (or any Linux box).
# setup.sh writes a ready-to-use copy of this for you. Use this file only to set it up by hand; see docs/MANUAL-SETUP.md.
# Settings (receiver IP, port) belong in the app's .env file, not here.
[Unit]
Description=Theater (web remote for Denon receivers)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Theater
ExecStart=/usr/bin/node --env-file-if-exists=.env server/index.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
